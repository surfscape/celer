<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Celer.Utilities">
    <Style TargetType="{x:Type local:BaseWindow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BaseWindow}">
                    <Border
                        x:Name="PART_HighContrastBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_MainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding NavigationControls}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding TitleBarMenu}"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                                <TextBlock
                                    x:Name="PART_Title"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    LineHeight="13"
                                    LineStackingStrategy="BlockLineHeight"
                                    Text="{TemplateBinding Title}" />
                                <ContentPresenter
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding WindowTitle}" />
                                <Grid
                                    Grid.Column="3"
                                    VerticalAlignment="Top"
                                    ColumnDefinitions="auto,auto,auto"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button
                                        x:Name="PART_MinButton"
                                        Padding="18,12"
                                        local:ButtonHelper.CornerRadius="0"
                                        Focusable="False"
                                        Style="{DynamicResource TransparentButton}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="&#xE921;" />
                                    </Button>
                                    <Button
                                        x:Name="PART_MaxButton"
                                        Grid.Column="1"
                                        Padding="18,12"
                                        local:ButtonHelper.CornerRadius="0"
                                        Focusable="False"
                                        Style="{DynamicResource TransparentButton}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="&#xE922;" />
                                    </Button>
                                    <Button
                                        x:Name="PART_CloseButton"
                                        Grid.Column="2"
                                        Padding="18,12"
                                        local:ButtonHelper.BackgroundHover="#C42B1C"
                                        local:ButtonHelper.CornerRadius="0"
                                        Focusable="False"
                                        Style="{DynamicResource TransparentButton}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="&#xE8BB;" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>