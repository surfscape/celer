<utils:BaseWindow
    x:Class="Celer.Views.Windows.Utils.AmbientChecker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Celer.Views.Windows.Utils"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:Celer.Resources"
    xmlns:utils="clr-namespace:Celer.Utilities"
    Title="{x:Static resx:Resource.AmbientChecker}"
    Width="600"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <utils:BaseWindow.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </utils:BaseWindow.Resources>
    <Border Padding="15">
        <StackPanel>
            <TextBlock Style="{StaticResource Heading1}" Text="{x:Static resx:Resource.AmbientChecker}" />
            <TextBlock
                Margin="0,-4,0,16"
                FontSize="15"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resx:Resource.AmbientChecker_Description}"
                TextWrapping="Wrap" />
            <ItemsControl x:Name="ChecksList" Margin="0,0,0,15">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI Symbol"
                                FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="❓" />
                                        <Setter Property="Foreground" Value="Gray" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                <Setter Property="Text" Value="✔️" />
                                                <Setter Property="Foreground" Value="Green" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failure">
                                                <Setter Property="Text" Value="❌" />
                                                <Setter Property="Foreground" Value="Red" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Name}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontStyle="Italic"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Message}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                x:Name="StartCheckButton"
                MaxWidth="250"
                HorizontalAlignment="Center"
                Click="StartCheck_Click"
                Content="{x:Static resx:Resource.AmbientChecker_StartLabel}" />
        </StackPanel>
    </Border>
</utils:BaseWindow>