<local:BaseWindow
    x:Class="Celer.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Celer.Utilities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Celer.Models"
    xmlns:resx="clr-namespace:Celer.Resources"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:uc="clr-namespace:Celer.Views.Pages.Modules"
    xmlns:ucMa="clr-namespace:Celer.Views.Pages.Modules.Maintenance"
    xmlns:ucOp="clr-namespace:Celer.Views.Pages.Modules.Optimization"
    xmlns:ucOs="clr-namespace:Celer.Views.Pages.Modules.Opsec"
    xmlns:ucSo="clr-namespace:Celer.Views.Pages.Modules.Software"
    xmlns:viewmodels="clr-namespace:Celer.ViewModels"
    xmlns:viewmodelsOpsec="clr-namespace:Celer.ViewModels.OpsecVM"
    Title="Celer"
    Height="642"
    Width="980"
    MinWidth="980"
    MinHeight="642"
    d:Background="white"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <local:BaseWindow.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:MenuStateToolTipConverter x:Key="MenuStateToolTipConverter" />
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <uc:Dashboard />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CleanEngine}">
            <uc:Cleaning />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:OptimizationViewModel}">
            <ucOp:Optimization />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SoftwareViewModel}">
            <ucSo:Software />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MaintenanceViewModel}">
            <ucMa:Maintenance />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodelsOpsec:OverviewViewModel}">
            <ucOs:Opsec />
        </DataTemplate>
    </local:BaseWindow.Resources>
    <local:BaseWindow.NavigationControls>
        <StackPanel Orientation="Horizontal">
            <Button
                Padding="14,12"
                Command="{Binding ToggleCompactModeCommand}"
                Style="{DynamicResource TransparentButton}"
                ToolTip="{Binding TabControlCompactMode, Converter={StaticResource MenuStateToolTipConverter}}"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <iconPacks:PackIconLucide
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Kind="PanelLeft" />
            </Button>
            <Button
                Margin="6,0,0,0"
                Padding="14,12"
                Command="{Binding GoBackCommand}"
                IsEnabled="{Binding CanGoBack}"
                Style="{DynamicResource TransparentButton}"
                ToolTip="{x:Static resx:Resource.MainWindow_GoBackTooltip}"
                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibilityConverter}}"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <iconPacks:PackIconLucide
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Kind="ArrowLeft" />
            </Button>
        </StackPanel>
    </local:BaseWindow.NavigationControls>
    <local:BaseWindow.TitleBarMenu>
        <Menu
            x:Name="AppMenu"
            Margin="4,0,0,0"
            FontSize="14"
            WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Padding="4,0" ToolTip="{x:Static resx:Resource.MainWindow_MenuTooltip}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide
                            Width="12"
                            Height="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Kind="Menu" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="12"
                            LineHeight="12"
                            LineStackingStrategy="BlockLineHeight"
                            Text="{x:Static resx:Resource.Menu}" />
                    </StackPanel>
                </MenuItem.Header>
                <MenuItem
                    Command="{Binding OpenWindowCommand}"
                    CommandParameter="Settings"
                    Header="{x:Static resx:Resource.Menu_Settings}">
                    <MenuItem.Icon>
                        <iconPacks:PackIconLucide Foreground="{DynamicResource TextFillColorSecondaryBrush}" Kind="Settings" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="NavigationMenu" Header="_View">
                    <MenuItem
                        Command="{Binding NavigateToTabCommand}"
                        CommandParameter="Dashboard"
                        Header="{x:Static resx:Resource.Menu_View_Dashboard}" />
                    <MenuItem
                        Command="{Binding NavigateToTabCommand}"
                        CommandParameter="Cleaning"
                        Header="{x:Static resx:Resource.Menu_View_Cleaning}" />
                    <MenuItem
                        Command="{Binding NavigateToTabCommand}"
                        CommandParameter="Optimization"
                        Header="{x:Static resx:Resource.Menu_View_Optimization}" />
                    <MenuItem
                        Command="{Binding NavigateToTabCommand}"
                        CommandParameter="Software"
                        Header="{x:Static resx:Resource.Menu_View_Software}" />
                    <MenuItem
                        Command="{Binding NavigateToTabCommand}"
                        CommandParameter="Maintenance"
                        Header="{x:Static resx:Resource.Menu_View_Maintenance}" />
                    <MenuItem
                        Command="{Binding NavigateToTabCommand}"
                        CommandParameter="Privacy &amp; Security"
                        Header="{x:Static resx:Resource.Menu_View_Opsec}" />
                </MenuItem>
                <MenuItem Header="{x:Static resx:Resource.Menu_Tools}">
                    <MenuItem
                        Command="{Binding OpenWindowCommand}"
                        CommandParameter="Ambient"
                        Header="{x:Static resx:Resource.Menu_AmbientChecker}">
                        <MenuItem.Icon>
                            <iconPacks:PackIconLucide Foreground="{DynamicResource TextFillColorSecondaryBrush}" Kind="MonitorCheck" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding OpenWindowCommand}"
                        CommandParameter="Update"
                        Header="_Check Updates"
                        IsEnabled="{Binding CanTriggerUpdate}">
                        <MenuItem.Icon>
                            <iconPacks:PackIconLucide Foreground="{DynamicResource TextFillColorSecondaryBrush}" Kind="RefreshCw" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem
                        Command="{Binding OpenLinkCommand}"
                        CommandParameter="https://ko-fi.com/reduxflakes"
                        Header="_Donate">
                        <MenuItem.Icon>
                            <iconPacks:PackIconLucide Foreground="{DynamicResource TextFillColorSecondaryBrush}" Kind="HandHeart" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding OpenLinkCommand}"
                        CommandParameter="https://surfscape.eu/support"
                        Header="_Support">
                        <MenuItem.Icon>
                            <iconPacks:PackIconLucide Foreground="{DynamicResource TextFillColorSecondaryBrush}" Kind="LifeBuoy" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding OpenLinkCommand}"
                        CommandParameter="https://github.com/surfscape/celer/issues"
                        Header="_Report Issues" />
                    <Separator />
                    <MenuItem
                        Command="{Binding OpenWindowCommand}"
                        CommandParameter="About"
                        Header="_About">
                        <MenuItem.Icon>
                            <iconPacks:PackIconLucide Foreground="{DynamicResource TextFillColorSecondaryBrush}" Kind="Info" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Command="{Binding CloseAppCommand}" Header="_Exit" />
            </MenuItem>
        </Menu>
    </local:BaseWindow.TitleBarMenu>
    <Grid>
        <!--  Main content  -->
        <Border>
            <Grid>
                <local:CompactTabControl
                    CompactMode="{Binding TabControlCompactMode, Mode=TwoWay}"
                    ItemsSource="{Binding TabsModule}"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource CelerStripTabLeft}">
                    <local:CompactTabControl.Resources>
                        <Style TargetType="{x:Type iconPacks:PackIconLucide}">
                            <Setter Property="Width" Value="15" />
                            <Setter Property="Height" Value="15" />
                        </Style>
                    </local:CompactTabControl.Resources>
                    <local:CompactTabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type model:TabModule}">
                            <ContentPresenter x:Name="AnimatedContent" Content="{Binding Content, NotifyOnTargetUpdated=True}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform Y="20" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                            <DataTemplate.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated" SourceName="AnimatedContent">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="AnimatedContent"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="28"
                                                To="0"
                                                Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation
                                                Storyboard.TargetName="AnimatedContent"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </local:CompactTabControl.ContentTemplate>
                </local:CompactTabControl>
            </Grid>
        </Border>
        <!--  Quick Center  -->
        <tb:TaskbarIcon
            x:Name="traybarMenu"
            DataContext="{Binding MenuViewModel}"
            IconSource="/Resources/Assets/app.ico"
            LeftClickCommand="{Binding QCOpenAppCommand}"
            NoLeftClickDelay="True"
            ToolTipText="Celer">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu x:Name="QCMenu">
                    <MenuItem
                        x:Name="ToggleMainWindowMenu"
                        Command="{Binding QCToogleWindowCommand}"
                        Header="Hide Celer" />
                    <!-- TODO
                        <MenuItem Header="Power Plans">
                            <MenuItem Header="Balanced" IsCheckable="True"></MenuItem>
                        </MenuItem>-->
                    <Separator />
                    <MenuItem Command="{Binding QCExitAppCommand}" Header="Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</local:BaseWindow>