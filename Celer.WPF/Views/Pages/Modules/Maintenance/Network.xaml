<UserControl
    x:Class="Celer.Views.Pages.Modules.Maintenance.Network"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Celer.Views.Pages.Modules.Maintenance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sg="clr-namespace:SpacedGridControl;assembly=SpacedGridControl"
    xmlns:uc="clr-namespace:Celer.Controls"
    xmlns:vm="clr-namespace:Celer.ViewModels"
    d:Background="white"
    d:DataContext="{d:DesignInstance Type=vm:MaintenanceVM.NetworkViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Heading2}">Network and Internet</TextBlock>
            <sg:SpacedGrid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            FontSize="17"
                            FontWeight="DemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Network Adapters" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding AdaptersFound}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            FontSize="17"
                            FontWeight="DemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Connection" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ConnectionStatus}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            FontSize="17"
                            FontWeight="DemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Internet Access" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding InternetConnectionStatus}" />
                    </StackPanel>
                </Border>
            </sg:SpacedGrid>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Heading2}">Tweaks</TextBlock>
            <uc:CelerOption
                Title="DNS"
                Description="Change the DNS system-wide"
                Icon="CloudCog">
                <StackPanel
                    Margin="0,6,0,12"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ComboBox
                        Width="225"
                        Height="30"
                        MaxWidth="270"
                        ItemsSource="{Binding DnsServers}"
                        SelectedItem="{Binding SelectedDnsServer}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Ipv4Primary}">
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                    <TextBlock Text=" (" />
                                    <TextBlock Text="{Binding PingStatus}" />
                                    <TextBlock Text=" ms)" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Margin="8,0,0,0"
                        Padding="8"
                        Command="{Binding UpdatePingCommand}"
                        ToolTip="Refresh Ping">
                        <iconPacks:PackIconLucide
                            Width="14"
                            Height="14"
                            Kind="RefreshCw" />
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        Padding="8"
                        Command="{Binding SetDnsCommand}"
                        IsEnabled="{Binding SelectedDnsServer, Converter={StaticResource NullToBoolConverter}}"
                        Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Apply">

                        <iconPacks:PackIconLucide
                            Width="14"
                            Height="14"
                            Kind="Check" />


                    </Button>
                </StackPanel>
            </uc:CelerOption>
        </StackPanel>
    </Grid>
</UserControl>
