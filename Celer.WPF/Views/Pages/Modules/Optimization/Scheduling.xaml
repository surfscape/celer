<UserControl
    x:Class="Celer.Views.Pages.Modules.Optimization.Scheduling"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Celer.Controls"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Celer.Views.Pages.Modules.Optimization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:optimizationvm="clr-namespace:Celer.ViewModels.OptimizationVM"
    d:DataContext="{d:DesignInstance Type=optimizationvm:SchedulingViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <Grid>
        <components:CelerOption
            Title="Priority Seperation"
            Description="Tells the Windows scheduler to either prioritize foreground processes or background services, with/without boosting"
            Icon="ArrowUp01">
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="0,0,4,0"
                    Padding="8"
                    Command="{Binding ResetValueToDefaultCommand}"
                    ToolTip="Reset to default"
                    Visibility="{Binding IsDefaultValue, Converter={StaticResource BoolToVisConverter}, ConverterParameter=true}">
                    <iconPacks:PackIconLucide
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Kind="RefreshCw" />
                </Button>
                <ComboBox
                    MinWidth="170"
                    DisplayMemberPath="Description"
                    ItemsSource="{Binding PriorityOptions}"
                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                    SelectedValuePath="MaskValue" />
            </StackPanel>
        </components:CelerOption>
    </Grid>
</UserControl>
