<UserControl
    x:Class="Celer.Views.Pages.Modules.Software.Software"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Celer.Views.Components"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subviews="clr-namespace:Celer.Views.Pages.Modules.Software"
    xmlns:subviewsViewModels="clr-namespace:Celer.ViewModels.SoftwareVM" xmlns:viewmodels="clr-namespace:Celer.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SoftwareViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Border>
        <StackPanel>
            <components:ModuleHeader
                ViewDescription="{Binding CurrentViewDescription}"
                ViewLabel="{Binding CurrentViewName}"
                Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}}" />
            <Border>
                <Grid>
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Style="{StaticResource Heading1}"
                                Text="Software" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,-4,0,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Manage software and applications" />
                        </Grid>
                        <StackPanel Grid.Row="1">
                            <UniformGrid Margin="-10,-5,0,0" Columns="1">
                                <components:ModuleButton
                                    Description="Install or upgrade software"
                                    Icon="Package"
                                    Label="Package Manager"
                                    NavigateCommand="{Binding NavigateCommand}"
                                    NavigateTo="PackageManager" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                    <ContentControl Content="{Binding CurrentView}" Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type subviewsViewModels:PackageManagerViewModel}">
                                <subviews:PackageManager />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
