<UserControl
    x:Class="Celer.Views.Pages.Modules.Optimization.Video"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Optimizationvm="clr-namespace:Celer.ViewModels.OptimizationVM"
    xmlns:components="clr-namespace:Celer.Views.Components"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Celer.Views.Pages.Modules.Optimization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=Optimizationvm:VideoViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToGpuTypeConverter x:Key="BoolToGpuTypeConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <Grid>
        <components:ModuleLoadingStatus Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}, ConverterParameter=True}">
            <DockPanel>
                <TextBlock Style="{StaticResource Heading1}">GPU Information</TextBlock>
                <ComboBox
                    Width="300"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Gpus}"
                    SelectedItem="{Binding SelectedGpu}" />
            </DockPanel>
            <Border Padding="0,0,0,8">
                <UniformGrid Columns="3" DataContext="{Binding SelectedGpu}">
                    <UniformGrid.Resources>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                        </Style>
                        <Style x:Key="Title" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="17" />
                            <Setter Property="FontWeight" Value="DemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Style>
                        <Style x:Key="Description" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </UniformGrid.Resources>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Manufacturer" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding Manufacturer}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Model" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding Name}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Driver Version" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding DriverVersion}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="GPU Type" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding AdapterType}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="DirectX Version" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding DirectXVersion}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="WDDM Version" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding WddmVersion}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="WHQL" />
                        <TextBlock
                            Style="{StaticResource Description}"
                            Text="{Binding IsWhqlLogoPresent}"
                            ToolTip="The driver passed the manufacturer tests &amp; the Windows Hardware Lab Kit. If false it either means the driver is a modified/unnoficial version or it's from a beta branch. " />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="HDR Support" />
                        <TextBlock
                            Style="{StaticResource Description}"
                            Text="{Binding SupportsHDR}"
                            ToolTip="Even if your GPU supports HDR, the feature depends on if the display also supports it." />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Paravirtualization" />
                        <TextBlock
                            Style="{StaticResource Description}"
                            Text="{Binding SupportsParavirtualization}"
                            ToolTip="Let's you do a passthrough of the GPU to a virtual machine." />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Total Memory" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding MemoryTotalMb, StringFormat={}{0} MB}" />
                    </StackPanel>
                </UniformGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
