<UserControl
    x:Class="Celer.Views.Pages.Modules.Optimization.Optimization"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local1="clr-namespace:Celer.Views.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subviews="clr-namespace:Celer.Views.Pages.Modules.Optimization"
    xmlns:subviewsViewModels="clr-namespace:Celer.ViewModels.OptimizationVM"
    xmlns:viewmodels="clr-namespace:Celer.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:OptimizationViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Border>
        <StackPanel>
            <local1:ModuleHeader ViewDescription="{Binding CurrentViewDescription}" ViewLabel="{Binding CurrentViewName}" Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}}" />
            <Border>
                <Grid>
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Style="{StaticResource Heading1}"
                                Text="Optimization" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,-4,0,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Tools to help optimize your system" />
                        </Grid>

                        <StackPanel Grid.Row="1">
                            <UniformGrid Margin="-10,-5,0,0" Columns="1">
                                <local1:ModuleButton
                                    Description="Check the state of your computer battery, and change system power plans"
                                    Icon="Battery"
                                    Label="Power Manager"
                                    NavigateCommand="{Binding NavigateCommand}"
                                    NavigateTo="Battery" />
                                <local1:ModuleButton
                                    Description="Check, clean, and configure memory behaviour"
                                    Icon="MemoryStick"
                                    Label="Memory Manager"
                                    NavigateCommand="{Binding NavigateCommand}"
                                    NavigateTo="Memory" />
                                <local1:ModuleButton
                                    Description="GPU and DWM settings"
                                    Icon="Gpu"
                                    Label="Video Manager"
                                    NavigateCommand="{Binding NavigateCommand}"
                                    NavigateTo="Video" />
                                <local1:ModuleButton
                                    Description="View your system sensors in real-time"
                                    Icon="Thermometer"
                                    Label="Sensors"
                                    NavigateCommand="{Binding NavigateCommand}"
                                    NavigateTo="Sensors" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                    <ContentControl Content="{Binding CurrentView}" Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type subviewsViewModels:BatteryViewModel}">
                                <subviews:Battery />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type subviewsViewModels:MemoryViewModel}">
                                <subviews:MemoryManagement />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type subviewsViewModels:VideoViewModel}">
                                <subviews:Video />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type subviewsViewModels:SensorViewModel}">
                                <subviews:Sensors />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>