<UserControl
    x:Class="Celer.Views.Pages.Modules.Maintenance.Maintenance"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Celer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Celer.Views.Pages.Modules"
    xmlns:local1="clr-namespace:Celer.Views.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subviews="clr-namespace:Celer.Views.Pages.Modules.Maintenance"
    xmlns:subviewsViewModels="clr-namespace:Celer.ViewModels.MaintenanceVM"
    xmlns:viewmodels="clr-namespace:Celer.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Border>
        <StackPanel>
            <local1:ModuleHeader
                CurrentView="{Binding CurrentView}"
                ViewDescription="{Binding CurrentViewDescription}"
                ViewLabel="{Binding CurrentViewName}" />
            <Border Margin="0,16,0,0">
                <ContentControl Content="{Binding CurrentView.Content}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type viewmodels:MaintenanceViewModel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Style="{StaticResource Heading1}"
                                        Text="Maintenance" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,-4,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Tools to verify and fix the system" />
                                </Grid>
                                <UniformGrid Margin="-10,-5,0,0" Columns="1">
                                    <local1:ModuleButton
                                        Description="Run the official system repair utilities to check &amp; repair erros in the disk/image"
                                        Icon="Wrench"
                                        Label="System Repair"
                                        NavigateCommand="{Binding NavigateCommand}"
                                        NavigateTo="Repair" />
                                    <local1:ModuleButton
                                        Description="Check your network connection and change DNS system-wide"
                                        Icon="Network"
                                        Label="Network Manager"
                                        NavigateCommand="{Binding NavigateCommand}"
                                        NavigateTo="Network" />
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type subviewsViewModels:RepairViewModel}">
                            <subviews:Repair />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type subviewsViewModels:NetworkViewModel}">
                            <subviews:Network />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
